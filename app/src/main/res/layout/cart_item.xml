<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/cart_img"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/milk" />

        <LinearLayout
            android:id="@+id/cart_text_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/cart_img"
            android:layout_toStartOf="@id/delete_btn"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cart_prod_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/crimson"
                android:maxLines="1"
                android:text="Product Name"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cart_prod_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rs. 20,000"
                android:textColor="@color/pink"
                android:textSize="14sp" />

            <!-- Quantity controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageButton
                    android:id="@+id/cart_qty_minus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/iconminus"
                    android:background="@drawable/grey_circular_border"
                    android:padding="5dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/cart_qty_tv"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/black" />

                <ImageButton
                    android:id="@+id/cart_qty_plus"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/plusicon"
                    android:background="@drawable/grey_circular_border"
                    android:padding="5dp"
                    android:scaleType="fitCenter" />

            </LinearLayout>

            <TextView
                android:id="@+id/cart_item_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Total: Rs. 20,000"
                android:textColor="#673AB7"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/delete_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_delete" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
