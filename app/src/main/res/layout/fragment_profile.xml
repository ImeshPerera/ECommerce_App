<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:background="@drawable/meroon_circular_border">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/profile_avatar_img"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/ic_profile"
                        android:background="@drawable/white_circular_border"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/profile_avatar_edit_btn"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_alignBottom="@id/profile_avatar_img"
                        android:layout_alignEnd="@id/profile_avatar_img"
                        android:background="@drawable/white_circular_border"
                        android:src="@android:drawable/ic_menu_camera"
                        android:padding="4dp"
                        app:tint="#FF0057" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/profile_display_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="user@email.com"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Edit Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal Information"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="12sp"
                    android:textColor="#757575" />

                <EditText
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter your name"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:inputType="textPersonName"
                    android:background="@null"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone Number"
                    android:textSize="12sp"
                    android:textColor="#757575" />

                <EditText
                    android:id="@+id/profile_phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter your phone"
                    android:textSize="16sp"
                    android:textColor="#212121"
                    android:inputType="phone"
                    android:background="@null"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/profile_save_btn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save Changes"
                    android:textColor="@color/white"
                    android:backgroundTint="#FF0057"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Actions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <Button
                    android:id="@+id/profile_address_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Saved Shipping Addresses"
                    android:textColor="#3F51B5"
                    android:backgroundTint="#E8EAF6"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/profile_cart_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="View My Cart"
                    android:textColor="#FF0057"
                    android:backgroundTint="#FFF0F5"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/profile_logout_btn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Log Out"
                    android:textColor="#D32F2F"
                    android:backgroundTint="#FFEBEE" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
